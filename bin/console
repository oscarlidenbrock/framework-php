#!/usr/bin/env php
<?php

declare(strict_types=1);

use Framework\Core;
use Module\Content\ContentType\ContentTypeManager;
use Module\User\AccountManager;

require dirname(__DIR__) . '/vendor/autoload.php';

$arguments = $_SERVER['argv'] ?? [];
$command = null;
$workspace = null;
$connectionName = null;
$confirmed = false;
$positionals = [];
$fieldOptions = [];
foreach (array_slice($arguments, 1) as $argument) {
    if (str_starts_with($argument, '--workspace=') && $workspace === null) {
        $workspace = substr($argument, strlen('--workspace='));
    } elseif ($command === null && !str_starts_with($argument, '--')) {
        $command = $argument;
    } elseif (str_starts_with($argument, '--connection=') && $connectionName === null) {
        $connectionName = substr($argument, strlen('--connection='));
    } elseif ($argument === '--yes' && !$confirmed) {
        $confirmed = true;
    } elseif (preg_match('/^--(length|precision|scale)=([0-9]+)$/', $argument, $matches) && !isset($fieldOptions[$matches[1]])) {
        $fieldOptions[$matches[1]] = (int) $matches[2];
    } elseif ($command !== null && !str_starts_with($argument, '--')) {
        $positionals[] = $argument;
    } else {
        fwrite(STDERR, "Unknown or duplicate option: {$argument}\n");
        exit(2);
    }
}
$command ??= 'help';
if ($command === 'help') {
    echo "Usage: php bin/console [--workspace=name] module:list|theme:list|database:status|database:migrate|content:type:list|content:type:create|content:field:list|content:field:add|content:field:update|content:schema:status|content:schema:diff|content:schema:apply|user:create-admin [arguments] [--connection=name] [--yes]\n";
    exit(0);
}
if (!in_array($command, ['module:list', 'module:publish-assets', 'theme:list', 'theme:publish-assets', 'database:status', 'database:validate', 'database:migrate', 'content:type:list', 'content:type:create', 'content:field:list', 'content:field:add', 'content:field:update', 'content:schema:status', 'content:schema:diff', 'content:schema:apply', 'user:create-admin'], true)) {
    fwrite(STDERR, "Unknown command: {$command}\n");
    exit(2);
}
if ($workspace === '' || $connectionName === '' || $connectionName !== null && !str_starts_with($command, 'database:') && !str_starts_with($command, 'content:') || $confirmed && !in_array($command, ['database:migrate', 'content:schema:apply'], true) || $fieldOptions !== [] && !in_array($command, ['content:field:add', 'content:field:update'], true) || $positionals !== [] && !str_starts_with($command, 'content:') && $command !== 'user:create-admin') {
    fwrite(STDERR, "Invalid command option.\n");
    exit(2);
}
if ($command === 'database:migrate' && !$confirmed) {
    fwrite(STDERR, "Schema changes require --yes\n");
    exit(2);
}

try {
    $core = new Core(dirname(__DIR__), workspace: $workspace);
    $core->boot();
    if ($command === 'module:list') {
        $enabled = array_fill_keys(array_map(static fn ($module): string => $module->id, $core->enabledModules()), true);
        foreach ($core->modules()->discover() as $module) {
            echo $module->id . "\t" . (isset($enabled[$module->id]) ? 'enabled' : 'disabled') . "\n";
        }
    } elseif ($command === 'module:publish-assets') {
        $core->libraries()->publish('module');
        echo "Module assets published\n";
    } elseif ($command === 'theme:list') {
        foreach ($core->themes()->discover() as $theme) {
            echo $theme->id . "\t" . ($theme->id === $core->themes()->active()->id ? 'active' : 'available') . "\n";
        }
    } elseif ($command === 'theme:publish-assets') {
        $core->libraries()->publish('theme');
        echo "Theme assets published\n";
    } elseif ($command === 'database:status') {
        $database = $core->database($connectionName);
        $pending = $database->pendingMigrations();
        echo $database->name . "\t" . count($pending) . " pending migrations\n";
        foreach ($pending as $version) {
            echo $version . "\n";
        }
    } elseif ($command === 'database:validate') {
        $database = $core->database($connectionName);
        $database->connection()->getNativeConnection();
        $core->databases()->validateMappings();
        echo $database->name . "\tvalid\n";
    } elseif ($command === 'user:create-admin') {
        if (count($positionals) !== 1) {
            throw new InvalidArgumentException('user:create-admin expects one email address.');
        }
        $password = getenv('APP_ADMIN_PASSWORD');
        if (!is_string($password) || $password === '') {
            throw new InvalidArgumentException('APP_ADMIN_PASSWORD must be set for user:create-admin.');
        }
        if (strlen($password) < 12) {
            throw new InvalidArgumentException('APP_ADMIN_PASSWORD must contain at least 12 characters.');
        }
        if (!filter_var($positionals[0], FILTER_VALIDATE_EMAIL) || strlen($positionals[0]) > 255) {
            throw new InvalidArgumentException('user:create-admin needs a valid email address.');
        }
        if (!$core->container()->has('user.accounts')) {
            throw new LogicException('Enable the user and admin modules before creating the first administrator.');
        }
        $accounts = $core->container()->get('user.accounts');
        if (!$accounts instanceof AccountManager) {
            throw new LogicException('User module is not enabled.');
        }
        $account = $accounts->createFirstAdministrator($positionals[0], $password);
        echo $account->email() . "\tcreated\n";
    } elseif (str_starts_with($command, 'content:')) {
        $types = $core->container()->get('content.types');
        if (!$types instanceof ContentTypeManager) {
            throw new LogicException('Content module is not enabled.');
        }
        $expected = match ($command) {
            'content:type:list' => 0,
            'content:type:create' => 2,
            'content:field:list', 'content:schema:status', 'content:schema:diff', 'content:schema:apply' => 1,
            'content:field:add' => 3,
            'content:field:update' => 2,
        };
        if (count($positionals) !== $expected) {
            throw new InvalidArgumentException("{$command} expects {$expected} argument(s).");
        }
        if ($command === 'content:type:list') {
            foreach ($types->all($connectionName) as $type) {
                echo $type->namespace . "\t" . $type->label . "\t" . $type->schemaStatus . "\n";
            }
        } elseif ($command === 'content:type:create') {
            $type = $types->create($positionals[0], $positionals[1], connection: $connectionName);
            echo $type->namespace . "\tcreated\n";
        } elseif ($command === 'content:field:list') {
            foreach ($types->fields($positionals[0], $connectionName) as $field) {
                echo $field->name . "\t" . $field->type . "\t" . ($field->system ? 'system' : 'custom') . "\n";
            }
        } elseif ($command === 'content:field:add') {
            $settings = $fieldOptions;
            $types->addField($positionals[0], ['name' => $positionals[1], 'type' => $positionals[2], 'settings' => $settings], $connectionName);
            echo $positionals[1] . "\tpending\n";
        } elseif ($command === 'content:field:update') {
            if ($fieldOptions === []) {
                throw new InvalidArgumentException('Field update needs a setting option.');
            }
            $types->updateField($positionals[0], $positionals[1], ['settings' => $fieldOptions], $connectionName);
            echo $positionals[1] . "\tpending\n";
        } else {
            $schema = $types->schema($positionals[0], $connectionName);
            $changes = $schema->diff();
            if ($command === 'content:schema:apply') {
                $schema->apply($confirmed);
                echo $positionals[0] . "\tapplied\n";
            } elseif ($command === 'content:schema:status') {
                echo $positionals[0] . "\t" . ($changes === [] ? 'applied' : 'pending') . "\n";
            } else {
                foreach ($changes as $change) {
                    echo $change['kind'] . "\t" . $change['name'] . "\t" . ($change['destructive'] ? 'destructive' : 'safe') . "\n";
                }
            }
        }
    } else {
        $database = $core->database($connectionName);
        echo $database->name . "\t" . $database->migrate() . " migrations applied\n";
    }
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . "\n");
    exit(1);
}
