<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title|default('Framework') }}{% endblock %}</title>

    {% block stylesheets %}
        {{ assets_css() }}
    {% endblock %}
    {% block head_scripts %}
        {{ assets_js('head') }}
    {% endblock %}
</head>
<body>
    {% block content %}{% endblock %}

    {% block scripts %}
        {{ assets_js('body') }}
    {% endblock %}
</body>
</html>
