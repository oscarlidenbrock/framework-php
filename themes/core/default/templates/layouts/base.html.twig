<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title|default('Framework') }}{% endblock %}</title>

    {% block stylesheets %}
        {{ assets('fonts', 'head') }}
        {{ assets('css', 'head') }}
    {% endblock %}
    {% block head_scripts %}
        {{ assets('js', 'head') }}
    {% endblock %}
</head>
<body>
    {% block content %}
        {{ page|default('') }}
        {{ sidebar|default('') }}
    {% endblock %}

    {% block scripts %}
        {{ assets('js', 'body') }}
    {% endblock %}
</body>
</html>
