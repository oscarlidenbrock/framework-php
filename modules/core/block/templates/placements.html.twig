{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
<h1>Blocks: {{ theme }}</h1>
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if saved %}<p>Placements saved.</p>{% endif %}
<form method="post" action="{{ action }}">
<input type="hidden" name="_csrf" value="{{ csrf }}">
{% for id, block in blocks %}
<fieldset><legend>{{ block.label() }}</legend>
<label><input type="checkbox" name="blocks[{{ id }}][enabled]" {% if current[id].enabled|default(false) %}checked{% endif %}> Enabled</label>
<label>Region <select name="blocks[{{ id }}][region]">{% for region in regions|keys %}<option value="{{ region }}" {% if current[id].region|default('page') == region %}selected{% endif %}>{{ region }}</option>{% endfor %}</select></label>
<label>Weight <input type="number" name="blocks[{{ id }}][weight]" value="{{ current[id].weight|default(0) }}"></label>
</fieldset>
{% endfor %}
<button type="submit">Save placements</button>
</form>
{% endblock %}
