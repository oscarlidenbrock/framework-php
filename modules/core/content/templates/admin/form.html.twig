{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
<p><a href="{{ back_url }}">Back to content</a></p>
<h1>{{ heading }}</h1>
{% if has_errors %}<p class="admin-error" role="alert">Please correct the marked fields.</p>{% endif %}
<div class="admin-card">
    <form method="post" action="{{ action }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        {{ form }}
        <button type="submit">Save content</button>
    </form>
</div>
{{ parent() }}
{% endblock %}
