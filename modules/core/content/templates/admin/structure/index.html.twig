{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
<div class="admin-toolbar">
    <div><p class="admin-eyebrow">Structure</p><h1>Content types</h1><p class="admin-muted">Define the fields used by your content.</p></div>
    {% if new_url %}<a class="button" href="{{ new_url }}">Add content type</a>{% endif %}
</div>
{% if notice %}<p class="admin-notice" role="status">{{ notice }}</p>{% endif %}
<form class="admin-filter" method="get" action="{{ structure_index_url }}">
    <label for="structure-connection">Database connection</label>
    <select id="structure-connection" name="connection">
        {% for name in connections %}<option value="{{ name }}"{% if name == connection %} selected{% endif %}>{{ name }}</option>{% endfor %}
    </select>
    <button type="submit">Show</button>
</form>
<div class="admin-card admin-table-wrap">
    {% if types is empty %}<p>No content types on this connection yet.</p>{% else %}
    <table class="admin-table">
        <thead><tr><th scope="col">Name</th><th scope="col">ID</th><th scope="col">Schema</th><th scope="col">Action</th></tr></thead>
        <tbody>{% for type in types %}<tr>
            <th scope="row"><a href="{{ type.url }}">{{ type.label }}</a></th>
            <td><code>{{ type.namespace }}</code></td>
            <td><span class="admin-badge">{{ type.status|capitalize }}</span></td>
            <td><a href="{{ type.url }}">Manage fields</a></td>
        </tr>{% endfor %}</tbody>
    </table>
    {% endif %}
</div>
{{ parent() }}
{% endblock %}
