{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
<p><a href="{{ back_url }}">← {{ type.label }} fields</a></p>
<p class="admin-eyebrow">Structure · {{ type.connection }}</p>
<h1>Review schema changes</h1>
<p class="admin-lead">{{ type.label }} · {{ type.schemaStatus|capitalize }}</p>
{% if error %}<p class="admin-error" role="alert">{{ error }}</p>{% endif %}
<div class="admin-card">
    {% if changes is empty %}<p>The physical schema matches the field definitions.</p>{% else %}
        <table class="admin-table"><thead><tr><th scope="col">Change</th><th scope="col">Column or index</th><th scope="col">Safety</th></tr></thead>
        <tbody>{% for change in changes %}<tr><td>{{ change.kind|replace({'_': ' '})|capitalize }}</td><td><code>{{ change.name }}</code></td><td>{{ change.destructive ? 'Requires manual review' : 'Safe' }}</td></tr>{% endfor %}</tbody></table>
    {% endif %}
</div>
{% if not safe %}<p class="admin-error" role="alert">These changes cannot be applied from administration. Use a reviewed data migration or the CLI.</p>{% endif %}
{% if apply_url %}
    <form method="post" action="{{ apply_url }}"><input type="hidden" name="_csrf" value="{{ csrf }}"><button type="submit">Apply safe changes</button></form>
{% endif %}
{{ parent() }}
{% endblock %}
