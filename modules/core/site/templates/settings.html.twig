{% extends '@theme/layouts/base.html.twig' %}
{% block content %}
<p class="admin-eyebrow">Configuration</p>
<h1>General settings</h1>
<p class="admin-lead">Set the name and contact address shown across your site.</p>
{% if notice %}<p class="admin-notice" role="status">{{ notice }}</p>{% endif %}
{% if error %}<p class="admin-error" role="alert">{{ error }}</p>{% endif %}
<div class="admin-card">
    {% if can_edit %}
    <form method="post" action="{{ action }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="content-field">
            <label for="site-title">Site title</label>
            <input id="site-title" name="title" value="{{ values.title }}" maxlength="120">
            <small>Default for this workspace: {{ details.title.default }}{% if details.title.overridden %} · Custom value active{% endif %}</small>
            <label><input type="checkbox" name="reset_title" value="1"{% if reset.title %} checked{% endif %}> Restore the default title</label>
        </div>
        <div class="content-field">
            <label for="site-email">Site email</label>
            <input id="site-email" name="email" type="email" value="{{ values.email }}" maxlength="254">
            <small>Default for this workspace: {{ details.email.default }}{% if details.email.overridden %} · Custom value active{% endif %}</small>
            <label><input type="checkbox" name="reset_email" value="1"{% if reset.email %} checked{% endif %}> Restore the default email</label>
        </div>
        <button type="submit">Save settings</button>
    </form>
    {% else %}
    <dl>
        <dt>Site title</dt><dd>{{ details.title.effective }}</dd>
        <dt>Site email</dt><dd>{{ details.email.effective }}</dd>
    </dl>
    {% endif %}
</div>
{% endblock %}
